<!DOCTYPE html>
<html lang="zh-CN" data-theme="{{ data.theme }}">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{ data.post.title or data.post.platform.name }} · {{ data.meta.bot_name }}</title>
        <link rel="stylesheet" href="icon.css" />
        <link rel="stylesheet" href="tailwind.css" />
        <link rel="stylesheet" href="showcase.css" />
        <link rel="stylesheet" href="music.css" />
        {% from "macros.jinja" import render_platform_brand, resolve_cover_src %}
    </head>
    <body class="showcase-body">
        {% set post = data.post %}
        {% set cover_src = resolve_cover_src(post) %}
        {% set extra = post.extra %}
        {% set facts = [
            {'label': '专辑', 'value': extra.album|default('')},
            {'label': '唱片公司', 'value': extra.record_label|default('')},
            {'label': '发行日期', 'value': extra.release_date|default('')}
        ] %}
        <main class="showcase-card music-card music-card--{{ post.platform.id }}">
            {% if cover_src %}<img class="showcase-ambient" src="{{ cover_src }}" alt="" />{% endif %}
            <div class="showcase-wash"></div>
            <div class="showcase-inner music-inner">
                <header class="music-header">
                    <div class="music-heading">
                        <span class="music-heading-mark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v12.2A3.5 3.5 0 1 1 7 13V5l13-3v12.2a3.5 3.5 0 1 1-2-3.2V4.5L9 6.6V4z" fill="currentColor" /></svg></span>
                        <span><small>MUSIC PLAYER</small><strong>音乐分享</strong></span>
                    </div>
                    {{ render_platform_brand(post.platform) }}
                </header>

                <section class="music-player" aria-label="音乐播放器卡片">
                    <div class="music-cover-shell">
                        {% if cover_src %}
                            <img class="music-cover" src="{{ cover_src }}" alt="{{ post.title }}专辑封面" />
                        {% else %}
                            <span class="music-cover music-cover--missing"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v12.2A3.5 3.5 0 1 1 7 13V5l13-3v12.2a3.5 3.5 0 1 1-2-3.2V4.5L9 6.6V4z" fill="currentColor" /></svg></span>
                        {% endif %}
                    </div>
                    <div class="music-track">
                        <div class="music-track-kicker">NOW PLAYING</div>
                        <h1>{{ post.title or '未命名歌曲' }}</h1>
                        <div class="music-artist">
                            {% if post.author.has_avatar %}
                                <img src="{{ post.author.avatar }}" alt="{{ post.author.name }}头像" />
                            {% else %}
                                <span class="music-artist-placeholder">{{ post.author.name[:1] }}</span>
                            {% endif %}
                            <span>{{ post.author.name }}</span>
                        </div>
                        <div class="music-player-controls" aria-hidden="true">
                            <span class="music-previous"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h2v14H5zM19 5v14L8 12z" fill="currentColor" /></svg></span>
                            <span class="music-play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
                            <span class="music-next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 5h2v14h-2zM5 5v14l11-7z" fill="currentColor" /></svg></span>
                        </div>
                    </div>
                    <div class="music-waveform" aria-hidden="true">
                        {% for height in [7, 13, 22, 15, 9, 18, 26, 17, 11, 24, 14, 8, 20, 29, 16, 10, 23, 13, 7, 17, 25, 14, 9, 19, 27, 12, 7, 21, 16, 9] %}
                            <i style="height: {{ height }}px"></i>
                        {% endfor %}
                    </div>
                </section>

                {% if extra.album|default('') or extra.record_label|default('') or extra.release_date|default('') %}
                    <section class="music-details" aria-label="歌曲资料">
                        <div class="music-facts">
                            {% for fact in facts if fact.value %}
                                <div class="music-fact">
                                    <div class="music-fact-label">
                                        {% if fact.label == '专辑' %}
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="2" fill="currentColor" /></svg>
                                        {% elif fact.label == '唱片公司' %}
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V7l8-4 8 4v13M8 10h2m4 0h2m-8 4h2m4 0h2M9 20v-3h6v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                        {% else %}
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M7 3v4m10-4v4M3 10h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                                        {% endif %}
                                        <span>{{ fact.label }}</span>
                                    </div>
                                    <div class="music-fact-value">{{ fact.value }}</div>
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                <footer class="showcase-footer music-footer">
                    <div class="showcase-footer-brand">
                        <img class="showcase-footer-icon showcase-footer-icon--nonebot" src="nonebot-logo.png" alt="NoneBot" />
                        <div class="showcase-footer-copy">
                            <small>NONEBOT-PLUGIN</small>
                            <strong>usoparser</strong>
                        </div>
                    </div>
                    <div class="showcase-footer-brand showcase-footer-brand--kkk" aria-label="致敬原项目 karin-plugin-kkk">
                        <!-- Emblem from karin-plugin-kkk v2.42.5 DefaultLayout.tsx (GPL-3.0). -->
                        <svg viewBox="0 0 230 221" aria-hidden="true">
                            <path d="M132.75,87.37l-53.72-53.37c-4.66-4.63-1.38-12.58,5.18-12.58h115.13c6.57,0,9.84,7.95,5.18,12.58l-53.72,53.37c-4.99,4.96-13.06,4.96-18.05,0Z" fill="currentColor" />
                            <path d="M28.49,186.89l.03-51.42c-.02-6.57,7.92-9.87,12.56-5.23l57.02,57.02c4.64,4.64,1.34,12.41-5.23,12.39h-51.42c-7.04-.02-12.94-5.72-12.96-12.76Z" fill="currentColor" />
                            <path d="M41.54,23.68l163.04,163.05c4.78,4.78,1.39,12.95-5.36,12.94h-47.88c-9.69,0-18.99-3.86-25.84-10.71L39.3,102.75c-6.85-6.85-10.7-16.15-10.7-25.84V29.04c0-6.76,8.16-10.14,12.94-5.36Z" fill="currentColor" />
                        </svg>
                        <div class="showcase-footer-copy">
                            <small>KARIN-PLUGIN</small>
                            <strong>kkk</strong>
                        </div>
                    </div>
                    <span class="showcase-footer-divider" aria-hidden="true"></span>
                    <div class="showcase-footer-brand showcase-footer-brand--author">
                        <img class="showcase-footer-icon" src="ukp.png" alt="UsotsukiKaze" />
                        <div class="showcase-footer-copy">
                            <small>POWERED BY</small>
                            <strong>UsotsukiKaze</strong>
                        </div>
                    </div>
                </footer>
            </div>
        </main>
    </body>
</html>
