<!DOCTYPE html>
<html lang="zh-CN" data-theme="{{ data.theme }}">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>评论区</title>
        <link rel="stylesheet" href="icon.css" />
        <link rel="stylesheet" href="tailwind.css" />
        {% from "macros.jinja" import render_comments %}
    </head>
    <body class="m-0 w-[620px] break-all bg-slate-200 font-sans dark:bg-slate-950">
        <main class="w-[620px] overflow-hidden rounded-lg bg-white py-4 shadow-lg dark:bg-slate-900 dark:shadow-black/30">
            <div class="px-8 pb-3 text-base font-bold text-slate-700 dark:text-slate-200">评论区</div>
            {{ render_comments(data.post.comments) }}
        </main>
    </body>
</html>
